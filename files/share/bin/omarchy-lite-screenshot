#!/bin/bash
# Usage: omarchy-lite-screenshot [region|screen]
dir="$HOME/Pictures/Screenshots"; mkdir -p "$dir"
file="$dir/screenshot-$(date +%F_%H-%M-%S).png"
case "${1:-region}" in
  region) g=$(slurp) || exit 0; grim -g "$g" "$file" ;;
  screen) grim -o "$(hyprctl activeworkspace -j | jq -r .monitor)" "$file" ;;
esac
wl-copy <"$file"
notify-send -i "$file" "Screenshot copied & saved" "$(basename "$file")"
