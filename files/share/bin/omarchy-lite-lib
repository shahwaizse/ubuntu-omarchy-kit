# Sourced by omarchy-lite scripts
OL="$HOME/.local/share/omarchy-lite"
CUR="$HOME/.config/omarchy/current"
PICS="$HOME/Pictures/omarchy"

# List a theme's wallpapers. Works with ~/Pictures/omarchy/<theme>/ folders
# or a flat ~/Pictures/omarchy with <theme>-<file> names.
theme_backgrounds() {
  local n=$1 f b t owner
  {
    if [[ -d $OL/themes/$n/backgrounds ]]; then
      find -L "$OL/themes/$n/backgrounds/" -maxdepth 1 -type f
    elif [[ -d $PICS/$n ]]; then
      find -L "$PICS/$n/" -maxdepth 1 -type f
    else
      for f in "$PICS/$n"-*; do
        [[ -f $f ]] || continue
        b=$(basename "$f"); owner=""
        for t in "$OL"/themes/*/; do
          t=$(basename "$t")
          [[ $b == "$t-"* && ${#t} -gt ${#owner} ]] && owner=$t
        done
        [[ $owner == "$n" ]] && echo "$f"
      done
    fi
  } | sort
}

# Show an image as wallpaper without flicker: start the new swaybg, then drop the old ones
show_background() {
  local old; old=$(pgrep -x swaybg)
  setsid -f swaybg -i "$1" -m fill >/dev/null 2>&1
  sleep 0.25
  [[ -n $old ]] && kill $old 2>/dev/null
}

# Make an image the saved wallpaper and show it
set_background() {
  ln -sfn "$1" "$CUR/background"
  show_background "$1"
}

# Restart the volume/brightness OSD and make sure it owns its D-Bus name (retry once)
restart_osd() {
  local try i
  for try in 1 2; do
    pkill -x swayosd-server
    for i in $(seq 30); do pgrep -x swayosd-server >/dev/null || break; sleep 0.1; done
    setsid -f swayosd-server </dev/null >/dev/null 2>&1
    for i in $(seq 30); do
      busctl --user status org.erikreider.swayosd-server >/dev/null 2>&1 && return 0
      sleep 0.1
    done
  done
}
