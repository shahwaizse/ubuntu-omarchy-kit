[main]
font=JetBrainsMono Nerd Font:size=12
prompt="❯ "
icons-enabled=yes
width=40
lines=12
horizontal-pad=20
vertical-pad=14
inner-pad=8
layer=overlay

[colors]
background={{ background_strip }}f5
text={{ foreground_strip }}ff
prompt={{ accent_strip }}ff
placeholder={{ color8_strip }}ff
input={{ foreground_strip }}ff
match={{ accent_strip }}ff
selection={{ selection_background_strip }}ff
selection-text={{ selection_foreground_strip }}ff
selection-match={{ background_strip }}ff
border={{ accent_strip }}ff

[border]
width=2
radius=0
